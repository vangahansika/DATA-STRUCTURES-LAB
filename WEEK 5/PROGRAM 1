{
cout<<"enter"<<n<<"elements:\n";
for(int i=0;i<n;i++)
{
cin>>ptr[i];
}
}
void calculate sum()
{
sum=0;
for(int i=0;i<n;i++)
{
sum=sum+ptr[i];
}
}
void display sum()
{
